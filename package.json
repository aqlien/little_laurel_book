{
  "name": "address-book",
  "version": "0.0.2-alpha",
  "private": true,
  "description": "Simple desktop address book built with Electron.",
  "main": "electron-main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "release": "npm run dist && node scripts/release.js"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.addressbook.simple",
    "productName": "Address Book",
    "files": [
      "**/*"
    ],
    "directories": {
      "buildResources": "build"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "publish": {
    "provider": "generic",
    "url": "https://github.com/aqlien/little_laurel_book/releases/download/latest/"
  }
}
